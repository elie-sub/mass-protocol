# Supabase (Project Settings → API). Without these the app runs on device storage only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Single-user lock: only this email can receive a login code. Comma-separate to allow more.
ALLOWED_EMAIL=elie@example.com
